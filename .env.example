# Cloudflare API token — provisions Workers/D1/Email Routing AND is used to
# read/write the D1 database at runtime. The one secret that must live outside
# the database. Needs: Workers Scripts:Edit, D1:Edit, Account Settings:Read,
# Email Routing:Edit.
CF_API_TOKEN=

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AGENTBOX_SECRET=
